{
  "name": "nafahat-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 4173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-postgres.mjs",
    "db:import": "node --env-file-if-exists=.env.local scripts/import-d1.mjs",
    "db:verify": "node --env-file-if-exists=.env.local scripts/verify-postgres.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/supabase-js": "^2.0.0",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@electric-sql/pglite": "^0.5.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
